# Express 서버 포트 (Keycloak 8080, 학교포털 A 3000과 겹치지 않게 3001 등 지정)
PORT=3002

# Express 세션 암호화 키 (서비스 A와 다른 임의의 문자열 권장)
SESSION_SECRET=elearning-b-super-secret-session-key-2026

# Keycloak Realm 주소 (서비스 A와 동일한 Realm 사용해야 SSO 연동 가능)
KEYCLOAK_ISSUER=http://localhost:8080/realms/university-sso

# Keycloak 클라이언트 설정 (서비스 B용으로 별도 생성한 Client ID 및 Secret 입력)
KEYCLOAK_CLIENT_ID=elearning-client
KEYCLOAK_CLIENT_SECRET=atRbv9mrh4E9Tun58rJrycrBHIDCPPnq

# OIDC 로그인 후 리다이렉트될 콜백 주소 (PORT 번호와 일치해야 함)
KEYCLOAK_CALLBACK_URL=http://localhost:3002/callback
