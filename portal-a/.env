# Express 서버 포트 (Keycloak이 8080을 사용하므로 3000 등 다른 포트 지정)
PORT=3001

# Express 세션 암호화 키 (임의의 복잡한 문자열로 변경 권장)
SESSION_SECRET=portal-a-super-secret-session-key-2026

# Keycloak Realm 주소 (본인이 생성한 Realm 이름으로 {realm-name} 부분 수정 필요)
KEYCLOAK_ISSUER=http://localhost:8080/realms/university-sso

# Keycloak 클라이언트 설정 (Keycloak 관리자 콘솔에서 발급받은 값으로 수정)
KEYCLOAK_CLIENT_ID=portal-client
KEYCLOAK_CLIENT_SECRET=VYvKKk4QZv4vshd8RIWWTysFHX25rBKi

# OIDC 로그인 후 리다이렉트될 콜백 주소 (PORT 번호와 일치해야 함)
KEYCLOAK_CALLBACK_URL=http://localhost:3001/callback
